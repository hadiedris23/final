<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- حذفت الخلفية والطبقة المظلمة هنا لأنها موجودة في الصفحة الرئيسية (activity_home) -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- تم حذف شريط التنقل المكرر من هنا -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCategoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Category"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- قائمة المنتجات كما هي -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProduct1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/imgProduct1"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/beedroom" />
                        <TextView
                            android:id="@+id/txtName1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Name"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtDesc1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Description" />
                        <TextView
                            android:id="@+id/txtRating1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Rating: 4.5/5"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtPrice1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/price_badge"
                            android:textColor="#FFFFFF"
                            android:text="$0"
                            android:textStyle="bold" />
                        <Button
                            android:id="@+id/btnAdd1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Add to Cart" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- باقي البطاقات (تم الحفاظ عليها) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProduct2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/imgProduct2"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/beedroom" />
                        <TextView
                            android:id="@+id/txtName2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Name"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtDesc2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Description" />
                        <TextView
                            android:id="@+id/txtRating2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Rating: 4.5/5"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtPrice2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/price_badge"
                            android:textColor="#FFFFFF"
                            android:text="$0"
                            android:textStyle="bold" />
                        <Button
                            android:id="@+id/btnAdd2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Add to Cart" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProduct3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/imgProduct3"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/beedroom" />
                        <TextView
                            android:id="@+id/txtName3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Name"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtDesc3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Description" />
                        <TextView
                            android:id="@+id/txtRating3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Rating: 4.5/5"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtPrice3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/price_badge"
                            android:textColor="#FFFFFF"
                            android:text="$0"
                            android:textStyle="bold" />
                        <Button
                            android:id="@+id/btnAdd3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Add to Cart" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProduct4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/imgProduct4"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/beedroom" />
                        <TextView
                            android:id="@+id/txtName4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Name"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtDesc4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Description" />
                        <TextView
                            android:id="@+id/txtRating4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Rating: 4.5/5"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtPrice4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/price_badge"
                            android:textColor="#FFFFFF"
                            android:text="$0"
                            android:textStyle="bold" />
                        <Button
                            android:id="@+id/btnAdd4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Add to Cart" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>